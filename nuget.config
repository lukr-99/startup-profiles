<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources. DotNetLib packages come from the owner's GitHub Packages feed, which needs a token with
  read:packages even to read. Locally the token lives in the user NuGet config under the source name
  "dotnetlib" (never in this repo); CI passes it through NuGetPackageSourceCredentials_dotnetlib.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnetlib" value="https://nuget.pkg.github.com/lukr-99/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnetlib">
      <package pattern="DotNetLib.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
