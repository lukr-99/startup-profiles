<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Allow the net10.0-windows host to be restored/built on non-Windows CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>lukr-99</Authors>
    <Copyright>Copyright (c) 2026 lukr-99</Copyright>
    <RepositoryUrl>https://github.com/lukr-99/startup-profiles</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
