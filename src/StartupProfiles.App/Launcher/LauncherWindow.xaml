<Window x:Class="StartupProfiles.App.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startup Profiles" Height="460" Width="560"
        MinHeight="330" MinWidth="340"
        Icon="pack://application:,,,/StartupProfiles;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource App.Background}"
        TextElement.Foreground="{DynamicResource App.Text}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="What are you doing?" FontSize="22" FontWeight="SemiBold"
               HorizontalAlignment="Center" Margin="0,4,0,20" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Profiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Margin="7" Padding="8,16" Cursor="Hand"
                    Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    Background="{DynamicResource App.Surface}"
                    Foreground="{DynamicResource App.Text}"
                    BorderBrush="{DynamicResource App.Border}">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource App.SurfaceAlt}">
                  <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" Margin="4,10,4,0" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource App.Muted}"
               HorizontalAlignment="Center" Margin="0,14,0,0" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
      <Button Content="Edit profiles" Command="{Binding EditCommand}" Margin="0,0,12,0" Padding="12,6" />
      <Button Content="Close" Command="{Binding CloseCommand}" Padding="12,6" />
    </StackPanel>
  </Grid>
</Window>
