<Window x:Class="StartupProfiles.App.Config.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:StartupProfiles.App.Config"
        xmlns:ui="clr-namespace:StartupProfiles.App.Ui"
        Title="Startup Profiles - Configuration" Height="640" Width="960"
        MinHeight="480" MinWidth="820"
        Icon="pack://application:,,,/StartupProfiles;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource App.Background}"
        TextElement.Foreground="{DynamicResource App.Text}">
  <Window.Resources>
    <ui:NullToVisibilityConverter x:Key="NullToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <ui:ActionIconConverter x:Key="ActionIcon" />
  </Window.Resources>

  <TabControl>
    <!-- ============ Profiles ============ -->
    <TabItem Header="Profiles">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="{DynamicResource App.Surface}">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
            <TextBlock Text="Profiles" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="+ New" Command="{Binding NewCommand}" Margin="12,0,0,0" Padding="8,3" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                   Background="Transparent" BorderThickness="0" Margin="6">
            <!-- The base is pinned first and set apart from the profiles below it. -->
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBase}" Value="True">
                    <Setter Property="Margin" Value="0,1,0,12" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock Text="{Binding ActionCount}" DockPanel.Dock="Right"
                               Foreground="{DynamicResource App.Muted}" />
                    <TextBlock Text="{Binding Name}" />
                  </DockPanel>
                  <TextBlock Text="Starts with every profile" FontSize="11" Margin="0,2,0,0"
                             Foreground="{DynamicResource App.Muted}"
                             Visibility="{Binding IsBase, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <!-- Empty state -->
        <TextBlock Grid.Column="1" Text="Select a profile, or create one."
                   Foreground="{DynamicResource App.Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Editor, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

        <!-- Editor -->
        <Grid Grid.Column="1" Margin="20"
              Visibility="{Binding Editor, Converter={StaticResource NullToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,8"
                      Visibility="{Binding Editor.IsBase, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Base" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Foreground="{DynamicResource App.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="These actions run first, every time a profile runs. Untick 'Include base' on a profile to skip them there." />
          </StackPanel>

          <WrapPanel Grid.Row="0" Visibility="{Binding Editor.IsProfile, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Name" Foreground="{DynamicResource App.Muted}" Margin="0,0,0,3" />
              <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                       Width="220" Height="32" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Icon" Foreground="{DynamicResource App.Muted}" Margin="0,0,0,3" />
              <Button Command="{Binding PickIconCommand}" Content="{Binding Editor.IconDisplay}"
                      FontFamily="Segoe UI Emoji" FontSize="16" Width="120" Height="32" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock Text="Startup" Foreground="{DynamicResource App.Muted}" Margin="0,0,0,3" />
              <ComboBox ItemsSource="{x:Static config:ProfileEditor.StartupBehaviours}"
                        SelectedItem="{Binding Editor.StartupBehaviour}" Width="220" Height="32" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom">
              <CheckBox Content="Include base" IsChecked="{Binding Editor.IncludeBase}" Height="32"
                        ToolTip="Run the base actions before this profile's own." />
            </StackPanel>
          </WrapPanel>

          <TextBlock Grid.Row="1" Text="Actions" FontWeight="SemiBold" Margin="0,10,0,6" />

          <DataGrid Grid.Row="2" ItemsSource="{Binding Editor.Actions}" SelectedItem="{Binding SelectedAction}"
                    AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                    CanUserSortColumns="False" CanUserReorderColumns="False">
            <DataGrid.Columns>
              <!-- The app's shell icon (exe, shortcut, or packaged app), as on Windows' Startup apps page. -->
              <DataGridTemplateColumn Width="40" CanUserResize="False" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Image Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource ActionIcon}">
                          <Binding Path="Type" />
                          <Binding Path="Target" />
                          <Binding Path="Arguments" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridComboBoxColumn Header="Type" Width="122"
                                      ItemsSource="{x:Static config:ActionEditor.ActionTypes}"
                                      SelectedItemBinding="{Binding Type}"
                                      EditingElementStyle="{StaticResource App.GridComboEditor}" />
              <DataGridTextColumn Header="Target" Width="*" Binding="{Binding Target}"
                                  ElementStyle="{StaticResource App.GridTextDisplay}"
                                  EditingElementStyle="{StaticResource App.GridTextEditor}" />
              <DataGridTextColumn Header="Arguments" Width="*" Binding="{Binding Arguments}"
                                  ElementStyle="{StaticResource App.GridTextDisplay}"
                                  EditingElementStyle="{StaticResource App.GridTextEditor}" />
              <DataGridTextColumn Header="Delay (s)" Width="72" Binding="{Binding DelaySeconds}"
                                  ElementStyle="{StaticResource App.GridTextDisplay}"
                                  EditingElementStyle="{StaticResource App.GridTextEditor}" />
              <DataGridComboBoxColumn Header="On failure" Width="104"
                                      ItemsSource="{x:Static config:ActionEditor.FailureBehaviours}"
                                      SelectedItemBinding="{Binding FailureBehaviour}"
                                      EditingElementStyle="{StaticResource App.GridComboEditor}" />
              <DataGridTextColumn Header="Retries" Width="64" Binding="{Binding RetryCount}"
                                  ElementStyle="{StaticResource App.GridTextDisplay}"
                                  EditingElementStyle="{StaticResource App.GridTextEditor}" />
              <DataGridCheckBoxColumn Header="Admin" Width="60" Binding="{Binding RunAsAdmin}"
                                      ElementStyle="{StaticResource App.GridCheckBox}"
                                      EditingElementStyle="{StaticResource App.GridCheckBox}" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Add" Command="{Binding AddActionCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Remove" Command="{Binding RemoveActionCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Move up" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Move down" Command="{Binding MoveDownCommand}" Padding="10,4" />
          </StackPanel>

          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource App.AccentButton}"
                    Margin="0,0,8,0" />
            <Button Content="Run now" Command="{Binding RunCommand}" Padding="12,7" Margin="0,0,8,0" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="12,7"
                    Foreground="{DynamicResource App.Danger}"
                    Visibility="{Binding Editor.IsProfile, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource App.Muted}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
        </Grid>
      </Grid>
    </TabItem>

    <!-- ============ Settings ============ -->
    <TabItem Header="Settings">
      <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Theme" Foreground="{DynamicResource App.Muted}" Margin="0,0,0,3" />
        <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Dark" />
        </ComboBox>

        <TextBlock Text="Profiles data" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,8" />
        <TextBlock Text="Export all profiles to a JSON file, or import them from one."
                   Foreground="{DynamicResource App.Muted}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
          <Button Content="Export..." Command="{Binding ExportCommand}" Padding="12,6" Margin="0,0,8,0" />
          <Button Content="Import..." Command="{Binding ImportCommand}" Padding="12,6" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource App.Muted}" Margin="0,12,0,0" />

        <TextBlock Text="Sync" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,8" />
        <CheckBox Content="Automatically sync profiles between machines" IsEnabled="False" />
        <TextBlock Text="Coming soon - profiles currently stay on this PC." Foreground="{DynamicResource App.Muted}"
                   Margin="26,4,0,0" />

        <TextBlock Text="About" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,8" />
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource App.Muted}" />
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>
