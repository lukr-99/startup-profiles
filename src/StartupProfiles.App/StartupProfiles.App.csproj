<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WPF for the launcher / config windows; WinForms only for the tray NotifyIcon. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StartupProfiles</AssemblyName>
    <RootNamespace>StartupProfiles.App</RootNamespace>
    <!-- Pin to the installed shared runtime; the SDK otherwise resolves 10.0.9 for the WPF
         markup-compile helper, which is not installed here. Roll-forward still runs it on newer patches. -->
    <RuntimeFrameworkVersion>10.0.7</RuntimeFrameworkVersion>
    <Product>Windows Startup Profiles</Product>
    <!-- Self-contained single-file publish defaults (overridable on the CLI) -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- WinForms is used only by the tray icon (which imports it explicitly). Drop the implicit
       global using so WPF types (Application, MessageBox, Button, ...) resolve unambiguously. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StartupProfiles.Core\StartupProfiles.Core.csproj" />
    <ProjectReference Include="..\StartupProfiles.Windows\StartupProfiles.Windows.csproj" />
  </ItemGroup>

</Project>
