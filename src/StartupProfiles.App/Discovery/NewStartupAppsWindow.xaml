<Window x:Class="StartupProfiles.App.Discovery.NewStartupAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartupProfiles.App.Ui"
        Title="New startup apps" Width="560" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontFamily="Segoe UI"
        Icon="pack://application:,,,/StartupProfiles;component/Assets/app.ico"
        Background="{DynamicResource App.Background}"
        TextElement.Foreground="{DynamicResource App.Text}">
  <Window.Resources>
    <ui:ActionIconConverter x:Key="ActionIcon" />
    <ui:ActionGlyphConverter x:Key="ActionGlyph" />
    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <StackPanel Margin="24,20,24,20">
    <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Foreground="{DynamicResource App.Muted}" TextWrapping="Wrap" Margin="0,4,0,14"
               Text="Since last time, these set themselves to start when you log in. Choose where each should start instead. Picking a profile switches it off in Windows, so it only starts with that profile." />

    <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1" CornerRadius="8" Padding="4">
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="10,8">
                <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding App.Launch.Type, Converter={StaticResource ActionGlyph}}"
                             FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                             Foreground="{DynamicResource App.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Source, ElementName=AppIcon}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Image x:Name="AppIcon" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                      <MultiBinding Converter="{StaticResource ActionIcon}">
                        <Binding Path="App.Launch.Type" />
                        <Binding Path="App.Launch.Target" />
                        <Binding Path="App.Launch.Arguments" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </Grid>
                <ComboBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Center"
                          ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding App.Detail}" FontSize="11" Foreground="{DynamicResource App.Muted}"
                             TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding App.Launch.Target}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource App.Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
               Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />

    <TextBlock Foreground="{DynamicResource App.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
               Text="You can turn this check off in Settings. Uninstalling switches these apps back on in Windows." />

    <DockPanel Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                  Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
        <Button Content="Ask me later" Command="{Binding LaterCommand}" Padding="14,7" Margin="0,0,10,0"
                ToolTip="Decide next time Startup Profiles starts" />
        <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource App.AccentButton}" IsDefault="True" />
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Close" Command="{Binding LaterCommand}" Padding="14,7"
              Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}" />
      <Grid />
    </DockPanel>
  </StackPanel>
</Window>
