<Window x:Class="StartupProfiles.App.Integration.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartupProfiles.App.Ui"
        Title="Add to Startup Profiles" Height="720" Width="500"
        MinHeight="460" MinWidth="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" FontFamily="Segoe UI"
        Icon="pack://application:,,,/StartupProfiles;component/Assets/app.ico"
        Background="{DynamicResource App.Background}"
        TextElement.Foreground="{DynamicResource App.Text}">
  <Window.Resources>
    <ui:ShellIconConverter x:Key="ShellIcon" />
    <ui:NullToVisibilityConverter x:Key="NullToVis" />
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Add this app to a startup profile?" FontSize="20" FontWeight="SemiBold"
               TextWrapping="Wrap" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" Foreground="{DynamicResource App.Muted}" TextWrapping="Wrap" Margin="0,0,0,14"
               Text="It asked to be added. You choose where it belongs - nothing is added without your OK." />

    <!-- Requesting app card -->
    <Border Grid.Row="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
      <DockPanel>
        <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,2,12,0" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="{Binding IconSource, Converter={StaticResource ShellIcon}}"
               Visibility="{Binding Source, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVis}}" />
        <StackPanel>
          <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource App.Muted}" Margin="0,2,0,8" />
          <TextBlock Text="{Binding Target}" Foreground="{DynamicResource App.Muted}" FontSize="12"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" />
          <TextBlock Text="{Binding Arguments}" Foreground="{DynamicResource App.Muted}" FontSize="12"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Arguments}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Destinations: the base first, then every profile. The list scrolls, so a long list stays reachable. -->
    <DockPanel Grid.Row="3">
      <TextBlock DockPanel.Dock="Top" Text="Add to" FontWeight="SemiBold" Margin="0,0,0,6" />
      <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}"
              BorderThickness="1" CornerRadius="8" Padding="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- The base is set apart above the profiles, the way the config sidebar pins it. -->
                <Border CornerRadius="6" Padding="8,6">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBase}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
                          <Setter Property="Margin" Value="0,0,0,6" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                      <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"
                              Background="{DynamicResource App.SurfaceHover}">
                        <TextBlock Text="{Binding Glyph}" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Emoji, Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"
                                   Foreground="{DynamicResource App.Muted}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                  </CheckBox>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </DockPanel>

    <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource App.Muted}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <TextBlock Foreground="{DynamicResource App.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                 Text="Just recognize keeps it in your library without starting it anywhere, so you can drag it into a profile later." />
      <DockPanel>
        <Button Content="Don't add" Command="{Binding DontAddCommand}" DockPanel.Dock="Left" Padding="14,7" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Just recognize" Command="{Binding RecognizeCommand}" Padding="14,7" Margin="0,0,10,0" />
          <Button Content="Add" Command="{Binding AddCommand}" Style="{StaticResource App.AccentButton}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
