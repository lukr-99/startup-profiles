<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Semantic color tokens (dark). Control styles live in Controls.xaml and resolve these by
       DynamicResource, so switching the merged theme dictionary re-colors every control live. -->
  <SolidColorBrush x:Key="App.Background" Color="#14161B" />
  <SolidColorBrush x:Key="App.Surface" Color="#1C1F27" />
  <SolidColorBrush x:Key="App.SurfaceAlt" Color="#232733" />
  <SolidColorBrush x:Key="App.SurfaceHover" Color="#2A2F3C" />
  <SolidColorBrush x:Key="App.Border" Color="#333846" />
  <SolidColorBrush x:Key="App.Text" Color="#EEF0F4" />
  <SolidColorBrush x:Key="App.Muted" Color="#9AA0B0" />
  <SolidColorBrush x:Key="App.Accent" Color="#5B86F7" />
  <SolidColorBrush x:Key="App.AccentHover" Color="#6E95F8" />
  <SolidColorBrush x:Key="App.AccentPressed" Color="#4A76E8" />
  <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.Danger" Color="#F0576B" />
  <SolidColorBrush x:Key="App.DangerHover" Color="#F36E7F" />
  <SolidColorBrush x:Key="App.DangerSoft" Color="#3A222A" />
  <SolidColorBrush x:Key="App.Selection" Color="#2A3550" />
  <SolidColorBrush x:Key="App.OnSelection" Color="#EEF0F4" />
  <SolidColorBrush x:Key="App.ScrollThumb" Color="#3A4150" />
  <SolidColorBrush x:Key="App.ScrollThumbHover" Color="#4C5566" />
</ResourceDictionary>
