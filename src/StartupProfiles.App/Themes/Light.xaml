<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Semantic color tokens (light). Control styles live in Controls.xaml and resolve these by
       DynamicResource, so switching the merged theme dictionary re-colors every control live. -->
  <SolidColorBrush x:Key="App.Background" Color="#F5F6F8" />
  <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.SurfaceAlt" Color="#EEF0F4" />
  <SolidColorBrush x:Key="App.SurfaceHover" Color="#E4E8EF" />
  <SolidColorBrush x:Key="App.Border" Color="#D9DCE3" />
  <SolidColorBrush x:Key="App.Text" Color="#1B1D22" />
  <SolidColorBrush x:Key="App.Muted" Color="#6B7080" />
  <SolidColorBrush x:Key="App.Accent" Color="#3B6EF5" />
  <SolidColorBrush x:Key="App.AccentHover" Color="#305FE0" />
  <SolidColorBrush x:Key="App.AccentPressed" Color="#2A55CC" />
  <SolidColorBrush x:Key="App.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="App.Danger" Color="#D1394A" />
  <SolidColorBrush x:Key="App.DangerHover" Color="#BC2F3F" />
  <SolidColorBrush x:Key="App.Selection" Color="#DCE6FF" />
  <SolidColorBrush x:Key="App.OnSelection" Color="#1B1D22" />
  <SolidColorBrush x:Key="App.ScrollThumb" Color="#C4CAD4" />
  <SolidColorBrush x:Key="App.ScrollThumbHover" Color="#A8B0BD" />
</ResourceDictionary>
